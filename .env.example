# MQTT
MQTT_URL=mqtt://host.docker.internal:1883
MQTT_CLIENT_ID=mqttvega02
MQTT_USERNAME=eastsoft
MQTT_PASSWORD=es
MQTT_RECONNECT_PERIOD=1000
MQTT_CONNECT_TIMEOUT=60000
MQTT_KEEPALIVE=60

# Modbus
# mode: tcp | rtu
MODBUS_MODE=tcp
MODBUS_HOST=0.0.0.0
MODBUS_PORT=502
# RTU only — Windows: COM3, Linux: /dev/ttyUSB0
MODBUS_SERIAL_PATH=/dev/ttyUSB0
MODBUS_BAUD_RATE=9600
MODBUS_DATA_BITS=8
MODBUS_STOP_BITS=1
MODBUS_PARITY=none

# UI
UI_PORT=18080

# Logging (set LOG_TO_FILE=false on SD-card devices like Raspberry Pi to avoid wear)
LOG_TO_FILE=true
