{
  "name": "vega-sdk",
  "version": "1.0.0",
  "description": "",
  "main": "CoreModule.js",
  "bin": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node index.js",
    "start": "node index.js",
    "start:prod": "cross-env NODE_ENV=production node index.js",
    "ecosystem": "pm2 start ecosystem.config.js --env production",
    "docker:build": "docker build -t vega-sdk:latest .",
    "docker:run": "docker run -d --name vega-sdk -p 502:502 -e NODE_ENV=production vega-sdk:latest",
    "docker:run:dev": "docker run -d --name vega-sdk-dev -p 502:502 -e NODE_ENV=development vega-sdk:latest",
    "docker:stop": "docker stop vega-sdk",
    "docker:remove": "docker rm vega-sdk",
    "docker:logs": "docker logs -f vega-sdk",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:build": "docker-compose up --build -d",
    "docker:compose:down": "docker-compose down",
    "docker:compose:logs": "docker-compose logs -f"
  },
  "assets": [
    "config_map.json",
    "exp.env",
    "node_modules/@serialport/bindings-cpp/prebuilds/win32-x64/*.node"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "commander": "^13.1.0",
    "dotenv": "^17.1.0",
    "events": "^3.3.0",
    "modbus-serial": "^8.0.17",
    "mqtt": "^5.10.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "xlsx": "^0.18.5"
  }
}
